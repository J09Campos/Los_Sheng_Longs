@page
@model Reloj_Marcador.Pages.Marca_Entrada_Salida.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Marcar Entrada-Salida";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/startbootstrap-sb-admin-2/4.1.4/css/sb-admin-2.min.css" rel="stylesheet" />

<h1>Marcar Entrada-Salida</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post" id="marcaForm">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Marca.Identificacion" class="control-label">Usuario</label>
                <input asp-for="Marca.Identificacion" id="IdentificacionInput" class="form-control" />
                <span asp-validation-for="Marca.Identificacion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Marca.Contrasena" class="control-label">Contraseña</label>
                <input asp-for="Marca.Contrasena" class="form-control" type="password" />
                <span asp-validation-for="Marca.Contrasena" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Área</label>
                <select asp-for="Marca.Id_Area" asp-items="Model.AreasLista" id="AreasCombo" class="form-control">
                </select>
                <span asp-validation-for="Marca.Id_Area" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Marca.Descripcion" class="control-label">Descripción (opcional)</label>
                <input asp-for="Marca.Descripcion" class="form-control" />
                <span asp-validation-for="Marca.Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Tipo de Marca</label>
                <select asp-for="Marca.Tipo_Marca" id="TipoMarca" class="form-control">
                    <option value="Entrada">Entrada</option>
                    <option value="Salida">Salida</option>
                </select>
                <span asp-validation-for="Marca.Tipo_Marca" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-sign-in-alt mr-1"></i> Marcar
                </button>
            </div>

            <!-- Campos ocultos de IP y ubicación -->
            <input type="hidden" asp-for="Marca.IP_Registro" id="IP_Registro" />
            <input type="hidden" asp-for="Marca.Latitud" id="Latitud" />
            <input type="hidden" asp-for="Marca.Longitud" id="Longitud" />
        </form>
    </div>
</div>

<!-- Modal de resultado -->
<div class="modal fade" id="systemMessageModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content border-left-primary shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@TempData.Peek("ModalTitle")</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">@TempData.Peek("ModalMessage")</div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("marcaForm");
            const ipInput = document.getElementById("IP_Registro");
            const latInput = document.getElementById("Latitud");
            const lonInput = document.getElementById("Longitud");

            // Mostrar modal si hay mensaje
            const modalMessage = "@(TempData["ModalMessage"] ?? "")";
            if (modalMessage.length > 0) {
                $("#systemMessageModal").modal("show");
            }

            // Cargar áreas según usuario
            document.getElementById("IdentificacionInput").addEventListener("blur", function () {
                const identificacion = this.value;
                fetch(?handler=ObtenerId&identificacion=${encodeURIComponent(identificacion)})
                    .then(r => r.json())
                    .then(data => {
                        const combo = document.getElementById("AreasCombo");
                        combo.innerHTML = "";
                        data.forEach(a => {
                            const opt = document.createElement("option");
                            opt.value = a.value;
                            opt.text = a.text;
                            combo.appendChild(opt);
                        });
                    })
                    .catch(err => console.error("Error cargando áreas:", err));
            });

            // Cargar IP y ubicación
            async function cargarDatosUbicacion() {
                try {
                    const ipResp = await fetch("https://api.ipify.org?format=json");
                    const ipData = await ipResp.json();
                    ipInput.value = ipData.ip;

                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(
                            pos => {
                                latInput.value = pos.coords.latitude.toFixed(6);
                                lonInput.value = pos.coords.longitude.toFixed(6);
                                console.log("Ubicación capturada:", latInput.value, lonInput.value);
                            },
                            err => console.error("Error GPS:", err),
                            { enableHighAccuracy: true, timeout: 10000 }
                        );
                    }
                } catch (err) {
                    console.error("Error obteniendo IP o coordenadas:", err);
                }
            }

            // Esperar IP/geo antes de enviar formulario
            form.addEventListener("submit", async (e) => {
                if (!ipInput.value || !latInput.value || !lonInput.value) {
                    e.preventDefault();
                    await cargarDatosUbicacion();
                    setTimeout(() => form.submit(), 1500);
                }
            });

            // Cargar datos de IP/geo al abrir
            cargarDatosUbicacion();
        });
    </script>
}